# Copie para .env na raiz do projeto para sobrescrever os defaults do docker-compose.
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:8080
ALLOWED_ORIGINS=http://localhost:8080
VITE_API_URL=http://localhost:8000

# Postgres. DB_PORT é a porta publicada no host (5434 pra não colidir com um
# Postgres local já instalado na 5432/5433) — usada tanto pelo docker-compose
# quanto pelo back-end quando roda fora do container (debug local).
DB_NAME=link_shortener
DB_USER=postgres
DB_PASSWORD=postgres
DB_PORT=5434

# DEBUG=1 liga o debugpy dentro do container 'backend' (porta 5678,
# usada pela config "Backend: Attach ao Docker" do VS Code). Não bloqueia
# a inicialização por padrão — o servidor sobe normal mesmo sem anexar.
DEBUG=0
DEBUG_HOST=0.0.0.0
DEBUG_PORT=5678
DEBUG_WAIT_FOR_CLIENT=false