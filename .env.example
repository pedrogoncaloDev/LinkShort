# Copie para .env na raiz do projeto para sobrescrever os defaults do docker-compose.

# FRONT-END (Vite)
# URL do back-end que o front chama (front_end/src/api.js).
VITE_API_URL=http://localhost:8000

# BACK-END (FastAPI) 

# URL pública do próprio back-end. Usada pra montar a "shortened_url"
# devolvida pelo /shorten (back_end/routes.py).
BACKEND_URL=http://localhost:8000

# Domínio do front-end. Usado no redirect de fallback quando o código
# não existe (back_end/routes.py).
FRONTEND_URL=http://localhost:8080

# Origens liberadas no CORS, separadas por vírgula (back_end/main.py).
ALLOWED_ORIGINS=http://localhost:8080

# --- Postgres ---
DB_NAME=link_shortener
DB_USER=postgres
DB_PASSWORD=postgres
DB_PORT=5434

# --- Debug remoto (debugpy) ---
DEBUG=0
DEBUG_HOST=0.0.0.0
DEBUG_PORT=5678
DEBUG_WAIT_FOR_CLIENT=false
